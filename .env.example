# Docker Compose: gigachat; для локальных моделей используйте .env.ollama.example.
RAG_LLM_PROVIDER=gigachat

# Ключ авторизации из кабинета GigaChat API (не access token).
GIGACHAT_API_KEY=replace-me
# Не используется текущим REST OAuth, сохранён для совместимости кабинета.
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

GENERATION_MODEL=GigaChat-2-Pro
EMBEDDING_MODEL=Embeddings-2
EMBEDDING_DIMENSION=1024
GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt
GIGACHAT_SERIALIZE_REQUESTS=true

# Не используются в режиме gigachat. Описание полного локального запуска — docs/LOCAL_MODELS.md.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=5m
OLLAMA_JSON_MODE=true
OLLAMA_THINK=false
OLLAMA_SERIALIZE_REQUESTS=true
VISION_INGESTION_ENABLED=true
VISION_MAX_OUTPUT_TOKENS=2400
VISUAL_PAGE_DPI=144
VISUAL_RENDER_TIMEOUT_SECONDS=120
VISUAL_MAX_PAGES=100
VISUAL_CONTEXT_MAX_CHUNKS=40

# Ограничения ingestion и retrieval.
MAX_UPLOAD_MB=25
CHUNK_MAX_CHARS=1100
CHUNK_OVERLAP_CHARS=160
RETRIEVAL_TOP_K=6
