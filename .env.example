# Рабочий режим: gigachat. Для офлайн-тестов: fake.
LLM_PROVIDER=gigachat

# Ключ авторизации из кабинета GigaChat API (не access token).
GIGACHAT_API_KEY=replace-me
# Не используется текущим REST OAuth, сохранён для совместимости кабинета.
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

GENERATION_MODEL=GigaChat-2-Pro
EMBEDDING_MODEL=Embeddings-2
EMBEDDING_DIMENSION=1024
GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt
GIGACHAT_SERIALIZE_REQUESTS=true

# Ограничения ingestion и retrieval.
MAX_UPLOAD_MB=25
CHUNK_MAX_CHARS=1100
CHUNK_OVERLAP_CHARS=160
RETRIEVAL_TOP_K=6
