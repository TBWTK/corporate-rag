# Полностью локальный режим: API-ключи не нужны.
RAG_LLM_PROVIDER=ollama

# Ollama запущен нативно на macOS/Windows, приложение работает в Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Рекомендуемый профиль для ноутбука с 32 ГБ RAM.
GENERATION_MODEL=qwen3:8b
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIMENSION=1024
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Стабильный JSON и умеренное потребление памяти/CPU.
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=5m
OLLAMA_JSON_MODE=true
OLLAMA_THINK=false
OLLAMA_SERIALIZE_REQUESTS=true

# Оставьте true для PDF/DOCX со скриншотами. Для только текстовых файлов можно поставить false
# и не скачивать OLLAMA_VISION_MODEL.
VISION_INGESTION_ENABLED=true
VISION_MAX_OUTPUT_TOKENS=2400
VISUAL_PAGE_DPI=144
VISUAL_RENDER_TIMEOUT_SECONDS=300
VISUAL_MAX_PAGES=100
VISUAL_CONTEXT_MAX_CHUNKS=32

# Общие лимиты MVP.
GENERATION_MAX_TOKENS=1200
EMBEDDING_BATCH_SIZE=4
MAX_UPLOAD_MB=25
CHUNK_MAX_CHARS=1100
CHUNK_OVERLAP_CHARS=160
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=18
